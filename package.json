{
  "name": "photograp",
  "version": "1.1.0",
  "private": false,
  "license": "MIT",
  "author": "Photograp Contributors",
  "description": "Photograp — an open-source, browser-based raster image editor with layers, selections, masks, filters and non-destructive adjustments.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "npm run build && tsc -p electron",
    "start": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:dir": "npm run build:desktop && electron-builder --dir",
    "icon": "electron scripts/make-icon.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit",
    "test": "electron tests/run-headless.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "org.photograp.editor",
    "productName": "Photograp",
    "copyright": "MIT License",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pgraph",
        "name": "Photograp Project",
        "description": "Photograp 專案檔",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Photograp"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sensa-code",
        "repo": "photograp"
      }
    ]
  }
}
